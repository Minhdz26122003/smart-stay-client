# Backend API Configuration
# Dùng HOSTNAME thay vì IP để tự động hoạt động trên mọi mạng

# Hostname của máy (tìm bằng lệnh: hostname)
# Thay YOUR-COMPUTER-NAME bằng tên máy thực tế
PHYSICAL_DEVICE_HOSTNAME=DESKTOP-6C83OGD.local

# Port của .NET backend
API_PORT=5043

# ============================================
# HƯỚNG DẪN:
# 1. Chạy lệnh: hostname
# 2. Copy tên máy (ví dụ: DESKTOP-ABC123)
# 3. Thay YOUR-COMPUTER-NAME bằng tên đó
# 4. Ví dụ: PHYSICAL_DEVICE_HOSTNAME=DESKTOP-ABC123.local
# ============================================